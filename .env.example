# Neon PostgreSQL
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Admin dashboard credentials (seeded by: npx tsx src/lib/sql/update_db.ts)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-admin-password
ADMIN_SECRET=change-me-to-a-long-random-string

# Midtrans payment gateway (Snap)
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxx
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxx

# RajaOngkir shipping cost API
RAJAONGKIR_API_KEY=your-rajaongkir-key
RAJAONGKIR_IS_PRO=false

# Public site URL (used for SEO/OpenGraph absolute URLs)
NEXT_PUBLIC_SITE_URL=https://taliwastra-store.vercel.app

# Optional: override the API base path used by the client (defaults to /api)
NEXT_PUBLIC_API_URL=